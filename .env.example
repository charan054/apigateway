# Copy to ".env" (same folder as docker-compose.yml) and change every value. ".env" is git-ignored.
# Plain KEY=value lines: no quotes.

# MySQL root password (also what every service connects with inside the stack).
DB_PASSWORD=change-this-db-password

# Bankapplication: the key bank.html (the admin console) sends, and the key PhonepayService uses to call the bank.
ADMIN_API_KEY=change-this-bank-admin-key
SERVICE_API_KEY=change-this-bank-service-key

# Shared by PhonepayService, ProductService and OrderService (they must all see the SAME value).
INTERNAL_SERVICE_API_KEY=change-this-internal-service-key

# Optional: Gmail address + App Password so sign-up / login / statement emails really go out.
MAIL_USERNAME=
MAIL_PASSWORD=

# Local development only: when an email cannot be sent, write the one-time code to the service log instead.
# Never true where real customers use it.
DEV_LOG_CODES=false
